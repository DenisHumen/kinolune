T[en.tuifail]="The full-screen installer did not start, switching to the text menu."
T[uk.tuifail]="Повноекранний інсталятор не запустився, відкриваю текстове меню."
T[ru.tuifail]="Полноэкранный установщик не запустился, открываю текстовое меню."

say() { t "$1"; echo; }
pause() { printf '\n%s ' "$(t enter)"; read -r _ || true; }

choose_language() {
    if [[ -s "${LANG_FILE}" ]]; then UI_LANG="$(cat "${LANG_FILE}")"; return; fi
    clear 2>/dev/null || true
    printf '\n  Kinolune OS %s\n\n' "${VERSION}"
    printf '  1) English\n  2) Українська\n  3) Русский\n\n'
    printf 'Language / Мова / Язык [1-3]: '
    local c
    read -r c || c=1
    case "${c}" in 2) UI_LANG=uk ;; 3) UI_LANG=ru ;; *) UI_LANG=en ;; esac
    echo "${UI_LANG}" > "${LANG_FILE}"
}

# The device the live system booted from (never offered for answer files or installs).
boot_device() {
    local src
    src="$(findmnt -no SOURCE /run/initramfs/live 2>/dev/null)" || return 0
    lsblk -no PKNAME "${src}" 2>/dev/null | head -n1
}

find_answers() {
    local boot dev fstype mnt f found=()
    boot="$(boot_device)"
    mkdir -p "${MEDIA_DIR}"
    while read -r dev fstype; do
        [[ -n "${fstype}" && "${fstype}" != swap && "${fstype}" != iso9660 && "${fstype}" != squashfs ]] || continue
        [[ -z "${boot}" || "$(lsblk -no PKNAME "${dev}" 2>/dev/null | head -n1)" != "${boot}" ]] || continue
        findmnt -rno TARGET -S "${dev}" >/dev/null 2>&1 && continue
        mnt="${MEDIA_DIR}/$(basename "${dev}")"
        mkdir -p "${mnt}"
        mount -o ro "${dev}" "${mnt}" 2>/dev/null || { rmdir "${mnt}"; continue; }
        for f in kinolune-answers.json answers.json; do
            [[ -f "${mnt}/${f}" ]] && found+=("${mnt}/${f}")
        done
    done < <(lsblk -rpno NAME,FSTYPE)
    if (( ${#found[@]} == 0 )); then
        say notfound
    else
        local pick=0 i
        if (( ${#found[@]} > 1 )); then
            for i in "${!found[@]}"; do printf '  %d) %s\n' "$((i + 1))" "${found[$i]}"; done
            printf '%s' "$(t which)"
            read -r i || i=1
            [[ "${i}" =~ ^[0-9]+$ ]] && (( i >= 1 && i <= ${#found[@]} )) && pick=$((i - 1))
        fi
        install -m 0600 "${found[$pick]}" "${ANSWERS}"
        echo "$(t found) ${ANSWERS}: ${found[$pick]}"
    fi
    for mnt in "${MEDIA_DIR}"/*; do
        [[ -d "${mnt}" ]] && { umount "${mnt}" 2>/dev/null; rmdir "${mnt}" 2>/dev/null; }
    done
    return 0
}

need_answers() {
    [[ -s "${ANSWERS}" ]] && return 0
    say nofile
    return 1
}

do_install() {
    need_answers || return 0
    exec 9> "${LOCK}"
    if ! flock -n 9; then say busy; return 0; fi
    # alpha-installer shows the plan and asks to type the disk name before wiping it.
    if alpha-installer install --answers "${ANSWERS}"; then
        printf '\n%s ' "$(t finished)"
        read -r _ || true
        systemctl reboot
    else
        echo
        say failed
    fi
    exec 9>&-
}

# The full-screen installer (DIST-006). Returns 1 when it could not run: the caller
# falls back to the text menu. Its last screen hands back an action.
run_tui() {
    [[ "${ALPHA_TEXT_MENU:-0}" != 1 ]] || return 1
    command -v alpha-installer >/dev/null 2>&1 || return 1
    local args=(tui --lang-file "${LANG_FILE}" --action-file "${ACTION_FILE}")
    # An answer file found on a USB stick (menu item 2) pre-fills the screens.
    [[ -s "${ANSWERS}" ]] && args+=(--answers "${ANSWERS}")
    rm -f "${ACTION_FILE}"
    if ! alpha-installer "${args[@]}"; then
        UI_LANG="$(cat "${LANG_FILE}" 2>/dev/null || echo en)"
        echo
        say tuifail
        sleep 3
        return 1
    fi
    case "$(cat "${ACTION_FILE}" 2>/dev/null)" in
        reboot) systemctl reboot; sleep 60 ;;
        poweroff) systemctl poweroff; sleep 60 ;;
    esac
    return 0
}

payload_check() {
    # The offline OS image (--bootc-installer-payload-ref) lives in containers-storage.
    [[ -n "$(podman images -q 2>/dev/null)" ]] || say payload
}

run_tui || true
choose_language
while true; do
    clear 2>/dev/null || true
    printf '\n  Kinolune OS %s - %s\n\n' "${VERSION}" "$(t title)"
    printf '%s\n\n' "$(t intro)"
    payload_check
    if [[ -s "${ANSWERS}" ]]; then a="${ANSWERS}"; else a="$(t none)"; fi
    printf '%s: %s\n\n' "$(t answers)" "${a}"
    for i in 1 2 3 4 5 6 7 8 9; do printf '  %d) %s\n' "${i}" "$(t "m${i}")"; done
    printf '\n%s' "$(t choose)"
    read -r choice || { sleep 1; continue; }
    echo
    case "${choice}" in
        1) alpha-installer disks --all; pause ;;
        2) find_answers; pause ;;
        3) [[ -s "${ANSWERS}" ]] || install -m 0600 "${EXAMPLE}" "${ANSWERS}"
           nano "${ANSWERS}" ;;
        4) need_answers && alpha-installer install --answers "${ANSWERS}" --dry-run; pause ;;
        5) do_install; pause ;;
        6) bash -l || true ;;
        7) systemctl reboot ;;
        8) systemctl poweroff ;;
        9) run_tui || pause
           [[ -s "${LANG_FILE}" ]] && UI_LANG="$(cat "${LANG_FILE}")" ;;
    esac
done
