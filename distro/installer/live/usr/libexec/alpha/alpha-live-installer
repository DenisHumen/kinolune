#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# Entry of the Kinolune OS installer ISO (DIST-007). Runs on tty1 (and on the serial
# console) instead of a login prompt, see alpha-live-installer@.service.
#
# First the full-screen installer (`alpha-installer tui`, DIST-006). This text menu is
# its fallback (the TUI did not start, or the user left it): it drives `alpha-installer`
# with an answer file: show disks, find or write the file, check the plan, install.
# Everything else (shell, reboot, back to the full-screen installer) is one key away.
# ALPHA_TEXT_MENU=1 skips the full-screen installer.
set -uo pipefail

VERSION="$(sed -n 's/^ALPHA_OS_VERSION=//p' /usr/share/alpha/installer/version 2>/dev/null)"
EXAMPLE=/usr/share/alpha/installer/answers.example.json
DOCS=https://github.com/DenisHumen/kinolune/tree/main/distro/installer
ANSWERS="${ALPHA_ANSWERS:-/root/answers.json}"
MEDIA_DIR=/run/alpha-live/media
LOCK=/run/alpha-live/install.lock
LANG_FILE=/run/alpha-live/language
ACTION_FILE="/run/alpha-live/action-$(basename "$(tty 2>/dev/null || echo console)")"
mkdir -p /run/alpha-live "$(realpath /root 2>/dev/null || echo /root)"
export LANG=C.UTF-8

