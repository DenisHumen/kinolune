# SPDX-License-Identifier: MPL-2.0
# `distro` module: NAS OS.
# Owned by the DIST workstream (docs/ROADMAP.md §0.4); its tasks replace this placeholder.

# List disks the installer would offer (read-only; --all shows excluded ones)
installer-disks *args:
    cd installer && go run ./cmd/alpha-installer disks {{args}}

# Installer plan for an answer file (validates it, touches nothing)
installer-plan answers *args:
    cd installer && go run ./cmd/alpha-installer install --answers {{answers}} --dry-run {{args}}

# Installer Go checks: gofmt, vet, tests on recorded lsblk/udev fixtures, a fake runner and TUI golden screens
installer-test:
    cd installer && test -z "$(gofmt -l .)" && go vet ./... && go test -race ./...

# Full-screen installer (DIST-006) on a recorded disk snapshot: every screen, nothing is written
installer-tui-demo snapshot="internal/disks/testdata/01-live-usb-nas":
    cd installer && go run ./cmd/alpha-installer tui --from {{snapshot}}

# QEMU: non-interactive install onto a virtual NVMe (OVMF), boot it, checks over SSH (~20 min)
installer-vm-test:
    tests/vm-install.sh

# Installer ISO: OS image + live installer image -> image-builder generic-iso, size < 1.9 GiB (~30 min)
iso:
    scripts/build-iso.sh

# Boot the installer ISO in QEMU/OVMF up to the installer menu (serial console smoke test)
iso-boot iso:
    tests/iso-boot.sh {{iso}}

# Update agent (alpha-updated) Go checks: gofmt, vet, tests on a fake bootc
updated-test:
    cd updated && test -z "$(gofmt -l .)" && go vet ./... && go test -race ./...

# Admin backend (alpha-admin) Go checks: gofmt, vet, tests on fake D-Bus services
admin-test:
    cd admin && test -z "$(gofmt -l .)" && go vet ./... && go test -race ./...

# alpha-admin with real PAM in a throw-away Fedora container
admin-pam-test:
    admin/tests/pam-container.sh

# alpha-admin end to end in QEMU (image build, install, API against the real OS)
admin-vm-test:
    admin/tests/vm-admin-e2e.sh
