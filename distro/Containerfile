# SPDX-License-Identifier: MPL-2.0
#
# NAS OS image (phase-0 prototype, DIST-001).
# Image-based OS built on the upstream bootc base image; see
# docs/adr/0010-nas-os-phase0.md and docs/research/05-nas-linux-distro.md.
#
# Build (from the repository root):
#   docker build -f distro/Containerfile -t localhost/alpha-os:dev distro
#   podman build -f distro/Containerfile -t localhost/alpha-os:dev distro
#
# The base is pinned by the digest of the multi-arch manifest list.
# Bump it deliberately (one PR per bump) and re-run the VM checks in distro/README.md.
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:45@sha256:2342f957281b061919c48a12227f9cd04f2d9825d17629fd914083aaa672002c

# Our Go daemons are built with the Go toolchain of the same pinned Fedora base
# (no second base image to pin); only the static binaries reach the OS image.
# alpha-updated has no third-party modules, so the build needs no module proxy.
FROM ${BASE_IMAGE} AS go-build
# hadolint ignore=DL3041
RUN dnf -y install --setopt=install_weak_deps=False golang && dnf clean all
COPY updated/ /src/updated/
# In bootc images /root is a symlink into /var (empty at build time), so the
# default ~/.cache/go-build cannot be created: keep Go's cache and GOPATH in /tmp.
ENV GOCACHE=/tmp/go-cache GOPATH=/tmp/go
RUN cd /src/updated && \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath \
    go build -ldflags=-s -o /out/alpha-updated ./cmd/alpha-updated

# Admin backend (DIST-013), built with the Go toolchain of the same pinned
# Fedora base; only the binaries reach the OS image. alpha-admin is static;
# alpha-admin-auth and alpha-admin-priv (DIST-018) link libpam (cgo), which the base image has. Go modules
# (godbus, msteinert/pam) come from the module proxy, checked against go.sum.
FROM ${BASE_IMAGE} AS admin-build
# hadolint ignore=DL3041
RUN dnf -y install --setopt=install_weak_deps=False golang gcc pam-devel && dnf clean all
COPY admin/ /src/admin/
RUN cd /src/admin && \
    export GOTOOLCHAIN=local GOFLAGS="-trimpath -mod=readonly" GOCACHE=/tmp/gocache GOPATH=/tmp/gopath && \
    CGO_ENABLED=0 go build -ldflags=-s -o /out/alpha-admin ./cmd/alpha-admin && \
    CGO_ENABLED=1 go build -tags pam -ldflags=-s -o /out/alpha-admin-auth ./cmd/alpha-admin-auth && \
    CGO_ENABLED=1 go build -tags pam -ldflags=-s -o /out/alpha-admin-priv ./cmd/alpha-admin-priv

FROM ${BASE_IMAGE}

COPY packages.txt /usr/share/alpha/packages.txt

# hadolint ignore=DL3041
RUN set -eux; \
    dnf -y install --setopt=install_weak_deps=False \
        $(grep -Ev '^\s*(#|$)' /usr/share/alpha/packages.txt); \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/lib/dnf /var/log/dnf* /var/log/hawkey.log

COPY rootfs/ /
# Update agent (DIST-009), see distro/updated/README.md.
COPY --from=go-build /out/alpha-updated /usr/libexec/alpha/alpha-updated
# Admin backend (DIST-013), see distro/admin/README.md.
COPY --from=admin-build /out/alpha-admin /out/alpha-admin-auth /out/alpha-admin-priv /usr/libexec/alpha/
# Public cosign key of the project (distro/keys/alpha-os.pub, committed by the owner).
COPY keys/ /usr/share/alpha/keys/

# Version of this image; the build scripts pass a unique value so that
# `bootc upgrade` always sees a new image.
ARG ALPHA_OS_VERSION=0.0.0-dev
# (declared after the package layer so a version bump keeps the dnf layer cached)

# Where the signed OS images are published (lower case, no tag).
ARG ALPHA_IMAGE_REPO=ghcr.io/denishumen/alpha-os
# Signature policy for `bootc switch|upgrade` (DIST-002, 05 §4.2 p.4):
#   auto    - enforce if distro/keys/alpha-os.pub exists, otherwise keep the stock policy;
#   enforce - require the key, fail the build without it (CI once the key is committed);
#   off     - keep the stock policy (local VM tests with unsigned images).
ARG ALPHA_SIGNATURE_POLICY=auto

RUN set -eux; \
    chmod 0755 /usr/libexec/alpha/*; \
    rm -f /usr/share/alpha/keys/.gitkeep; \
    policy="${ALPHA_SIGNATURE_POLICY}"; \
    if [ "${policy}" = auto ]; then \
        if [ -s /usr/share/alpha/keys/alpha-os.pub ]; then policy=enforce; else policy=off; fi; \
    fi; \
    case "${policy}" in \
        enforce) /usr/libexec/alpha/alpha-signature-policy "${ALPHA_IMAGE_REPO}" ;; \
        off) echo "WARNING: signature policy is off, this image accepts unsigned updates" ;; \
        *) echo "unknown ALPHA_SIGNATURE_POLICY=${policy}"; exit 1 ;; \
    esac; \
    # Kinolune OS name, os-release, issue, motd (DIST-003, see the script).
    /usr/libexec/alpha/alpha-branding "${ALPHA_OS_VERSION}"; \
    printf 'ALPHA_OS_VERSION=%s\nALPHA_IMAGE_REPO=%s\nALPHA_SIGNATURE_POLICY=%s\n' \
        "${ALPHA_OS_VERSION}" "${ALPHA_IMAGE_REPO}" "${policy}" > /usr/share/alpha/version; \
    # Updates are driven by our own agent (alpha-updated, DIST-009), never by the
    # stock timer that applies an update and reboots on its own (05 §4.2 p.1).
    # Masked (not just disabled) so a preset or a dependency cannot bring it back.
    systemctl mask bootc-fetch-apply-updates.timer bootc-fetch-apply-updates.service; \
    # Enable/disable services according to rootfs/usr/lib/systemd/system-preset/.
    # Cockpit is shipped but off; the admin UI turns it on for LAN only (05 §5.1).
    systemctl preset alpha-media.service alpha-admin.service alpha-admin-auth.socket alpha-updated.service alpha-updated.socket \
        alpha-admin-priv.socket alpha-samba-config.service alpha-ssh-firstboot.service \
        smb.service wsdd.service avahi-daemon.service firewalld.service smartd.service \
        chronyd.service sshd.service cockpit.socket; \
    # Firewall: default zone "home", only what we need (05 §5.2, DIST-018):
    # admin UI (http, https), SMB on 445 only (NetBIOS is off), media server,
    # mDNS and WS-Discovery, DHCPv6 replies. SSH is closed: alpha-ssh-firstboot
    # opens it when keys were installed, later the admin UI decides.
    firewall-offline-cmd --set-default-zone=home; \
    for svc in mdns ws-discovery http https; do \
        firewall-offline-cmd --zone=home --add-service="${svc}"; \
    done; \
    for svc in samba samba-client ssh; do \
        firewall-offline-cmd --zone=home --remove-service-from-zone="${svc}" || true; \
    done; \
    firewall-offline-cmd --zone=home --add-port=445/tcp; \
    firewall-offline-cmd --zone=home --add-port=8487/tcp; \
    # Leftovers of package scriptlets in runtime-only dirs (bootc lint: nonempty-run-tmp).
    rm -rf /run/dnf /run/cockpit /run/selinux-policy /var/log/* /var/cache/* /var/tmp/* /tmp/*; \
    bootc container lint

LABEL org.opencontainers.image.title="Kinolune OS" \
      org.opencontainers.image.description="Kinolune OS: NAS OS of the Kinolune project, based on Fedora Linux (image-based, bootc)" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.source="https://github.com/DenisHumen/kinolune" \
      org.opencontainers.image.version="${ALPHA_OS_VERSION}" \
      containers.bootc="1"
