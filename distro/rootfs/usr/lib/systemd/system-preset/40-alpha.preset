# SPDX-License-Identifier: MPL-2.0
# Services enabled in the NAS OS image (DIST-001). Applied with `systemctl preset` at build time.
enable alpha-media.service
enable alpha-admin.service
enable alpha-admin-auth.socket
enable alpha-admin-priv.socket
enable alpha-samba-config.service
enable alpha-ssh-firstboot.service
enable alpha-updated.service
enable alpha-updated.socket
enable smb.service
enable wsdd.service
enable avahi-daemon.service
enable firewalld.service
enable smartd.service
enable chronyd.service
# SSH is off by default (DIST-018); alpha-ssh-firstboot turns it on when keys were installed.
disable sshd.service
disable cockpit.socket
disable bootc-fetch-apply-updates.timer
