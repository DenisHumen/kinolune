# SPDX-License-Identifier: MPL-2.0
# Password check for the admin backend (DIST-013). One helper process per
# connection (Accept=yes). Only the alpha-admin user (the web daemon) and
# root can connect; the helper checks SO_PEERCRED again.
[Unit]
Description=Kinolune OS admin password check socket
Documentation=https://github.com/DenisHumen/kinolune/tree/main/distro/admin

[Socket]
ListenStream=/run/alpha-admin/auth.sock
Accept=yes
SocketUser=alpha-admin
SocketGroup=alpha-admin
SocketMode=0600
DirectoryMode=0755
MaxConnections=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
