// SPDX-License-Identifier: MPL-2.0
// Kinolune OS default for every user (DIST-003). fastfetch reads it from XDG_CONFIG_DIRS
// unless the user has ~/.config/fastfetch/config.jsonc. Without it fastfetch would pick the
// logo by ID_LIKE=fedora. Logo: distro/branding/gen-fastfetch-logo.py (the Kinolune mark);
// colours: moon #F3EFE4 and lune.400 #49D1D8 from design/brand/README.md.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kinolune-os/fastfetch-logo.txt",
    "color": {
      "1": "38;2;243;239;228",
      "2": "38;2;73;209;216"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "38;2;73;209;216",
      "title": "38;2;73;209;216"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
