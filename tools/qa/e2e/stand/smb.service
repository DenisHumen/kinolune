<!-- QA-016: announce the stand's SMB service over mDNS, as a NAS does. -->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">Kinolune e2e stand</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
</service-group>
