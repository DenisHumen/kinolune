<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PLAY-AND-003: cleartext HTTP only to the core's loopback proxy (the fallback of CoreDataSource). -->
    <application android:networkSecurityConfig="@xml/pa_loopback_network_security">
        <!-- ADR-0008: own Activity; a display mode switch (AFR, HDR) must not recreate the player. -->
        <activity
            android:name="dev.projectalpha.player.flutter.PlayerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true" />
    </application>
</manifest>
