<!-- PLAY-012 (ADR-NNNN): merged only into builds with the Google Cast SDK (not F-Droid, build.gradle.kts). The Cast framework
     reads its options (the Default Media Receiver) from this provider. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.kinolune.cast.CastOptionsProvider"/>
    </application>
</manifest>
