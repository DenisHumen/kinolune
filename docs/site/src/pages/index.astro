---
// SPDX-License-Identifier: MPL-2.0
// Site root: sends the visitor to their language (a remembered choice, then
// the browser languages, English otherwise). Without JavaScript the three
// language links stay on screen.
import '../generated/tokens.css';
import '../styles/site.css';
import { languageNames, locales, strings, href } from '../i18n/strings.mjs';

const targets = Object.fromEntries(locales.map((l) => [l, href(`${l}/`)]));
---
<!doctype html>
<html lang="uk" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kinolune</title>
    <meta name="description" content={strings.en['meta.description']} />
    <meta name="color-scheme" content="dark" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(targets[l], Astro.site)} />)}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon.ico')} sizes="32x32" />
    <script is:inline define:vars={{ targets }}>
      (function () {
        let pick;
        try { pick = localStorage.getItem('kinolune-lang'); } catch (_) {}
        if (!targets[pick]) {
          const prefs = navigator.languages || [navigator.language || ''];
          for (const p of prefs) {
            const code = String(p).toLowerCase().split('-')[0];
            if (targets[code]) { pick = code; break; }
          }
        }
        location.replace(targets[pick] || targets.en);
      })();
    </script>
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <main class="picker">
      <img src={href('assets/lockup-dark.svg')} alt="Kinolune" width="245" height="80" />
      <ul class="linkrow">
        {locales.map((l) => <li><a class="button" href={targets[l]} hreflang={l} lang={l}>{languageNames[l]}</a></li>)}
      </ul>
    </main>
  </body>
</html>
