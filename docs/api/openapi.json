{
  "openapi": "3.1.0",
  "info": {
    "title": "Kinolune server API",
    "description": "HTTP API of the Kinolune media server (alpha-media). Generated from the server code; do not edit by hand. Clients and servers whose major versions differ by at most one work together (ADR-0118).",
    "license": {
      "name": "MPL-2.0",
      "identifier": "MPL-2.0"
    },
    "version": "1.1"
  },
  "paths": {
    "/api/v1/auth/challenge": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "A challenge for a paired device to sign.",
        "description": "Valid for 60 s and once.",
        "operationId": "createChallenge",
        "responses": {
          "200": {
            "description": "A fresh challenge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "401": {
            "description": "Invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many open challenges",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/device": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs a paired device in with its device key.",
        "description": "The device signs the challenge (SYNC-005 `auth` transcript with the\nserver as verifier) and gets a device session: it can list profiles and\nsign members in with a PIN. Revoking the device ends the session.",
        "operationId": "loginDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Device signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unknown or revoked device, bad signature or challenge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Locked after failed attempts; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with name and password.",
        "description": "With the access token of a device session in `Authorization`, the new\nsession is bound to that device and ends when the device is revoked.\nFive wrong passwords lock the account for 30 s, doubling up to 15 min;\n20 failures lock the client address the same way.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Wrong name or password, or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Locked after failed attempts; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Ends the session of a refresh token.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed out (also for unknown tokens)"
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The caller's session.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/pin": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs a household member in with a profile PIN.",
        "description": "Only on a paired device: the request needs the access token of a session\nbound to one (a device session). Locks like a password.",
        "operationId": "loginPin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Wrong profile or PIN, or no valid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not on a paired device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Locked after failed attempts; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/profiles": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Profiles to pick on a device.",
        "description": "Every account with its name and whether it has a PIN; for any signed-in\nsession, typically a device session before a member picks a profile.",
        "operationId": "listProfiles",
        "responses": {
          "200": {
            "description": "The accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Users"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchanges a refresh token for a new pair.",
        "description": "Each refresh token works once. Presenting a used one again means it was\ncopied: the whole session is revoked.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A new pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired or reused token, or the session ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates the first administrator.",
        "description": "Works once, while no administrator exists: from the server itself, or\nfrom elsewhere with the code of `setup-code.txt` in the data directory.\nSigns the administrator in.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Administrator created and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Setup code missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "An administrator already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "tags": [
          "pairing"
        ],
        "summary": "Lists the devices of the family, revoked ones too.",
        "description": "For an administrator (or the server itself before the first\nadministrator exists).",
        "operationId": "listDevices",
        "responses": {
          "200": {
            "description": "The family",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Devices"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/devices/{id}": {
      "delete": {
        "tags": [
          "pairing"
        ],
        "summary": "Revokes a device and rotates the family key.",
        "description": "Its connections close and every session bound to it ends (its tokens stop\nworking at once). For an administrator (or the server itself before the\nfirst administrator exists).",
        "operationId": "revokeDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "400": {
            "description": "The device cannot be revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "410": {
            "description": "Already revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/pair": {
      "get": {
        "tags": [
          "pairing"
        ],
        "summary": "Pairs a new device (WebSocket).",
        "description": "Upgrades to the pairing protocol (`pa_pairing::pair`, SPAKE2 with the\ncode of the open invitation); the server is the inviter.",
        "operationId": "pairSocket",
        "responses": {
          "101": {
            "description": "WebSocket: pairing messages follow"
          },
          "400": {
            "description": "Not a WebSocket upgrade"
          },
          "401": {
            "description": "Invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pair/invite": {
      "post": {
        "tags": [
          "pairing"
        ],
        "summary": "Opens a pairing invitation.",
        "description": "A new code and its QR payload, replacing an open invitation. For an\nadministrator (or the server itself before the first administrator\nexists).",
        "operationId": "createInvite",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "`code` (default): 6 digits to type; `qr`: a long code for a QR code\nonly.",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Kind of pairing code.",
              "enum": [
                "code",
                "qr"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A new invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The invitation could not be made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/sync": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Syncs a paired device (WebSocket).",
        "description": "Upgrades to the sync protocol (`docs/api/sync-protocol.md`). Devices\nauthenticate with their paired keys (SYNC-005).",
        "operationId": "syncSocket",
        "responses": {
          "101": {
            "description": "WebSocket: sync protocol frames follow"
          },
          "400": {
            "description": "Not a WebSocket upgrade"
          },
          "401": {
            "description": "Invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "The hub has no free connection slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Lists the accounts.",
        "description": "For an administrator (or the server itself before the first\nadministrator exists).",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "The accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Users"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Adds an account: a household member (with a PIN and/or a password) or\nanother administrator (with a password).",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name, password or PIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The name is taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/users/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Deletes an account and ends its sessions.",
        "description": "The last administrator cannot be deleted.",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The last administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "auth"
        ],
        "summary": "Changes the password and/or PIN of an account.",
        "description": "For an administrator or the user themselves. Ends the user's other\nsessions.",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "User id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid password or PIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Neither an administrator nor the user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "server"
        ],
        "summary": "Liveness, readiness and versions.",
        "description": "200 if the library database answers, 503 if not.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server works",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The library database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "server"
        ],
        "summary": "Same as `/health`.",
        "description": "The NAS OS greenboot checks probe both paths (`distro/`).",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The server works",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The library database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Error body of the API endpoints (status codes 4xx and 5xx).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable reason, in English."
          }
        }
      },
      "ApiVersion": {
        "type": "object",
        "description": "Versions of the API this server speaks.",
        "required": [
          "major",
          "minor"
        ],
        "properties": {
          "major": {
            "type": "integer",
            "format": "int32",
            "description": "Major version: the same as TXT `v` and `/api/v<major>`.",
            "minimum": 0
          },
          "minor": {
            "type": "integer",
            "format": "int32",
            "description": "Minor version: grows with additive changes.",
            "minimum": 0
          }
        }
      },
      "Challenge": {
        "type": "object",
        "description": "A device challenge.",
        "required": [
          "challenge",
          "server_id",
          "expires_ms"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Nonce to sign (64 hex characters)."
          },
          "expires_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Expiry, Unix ms."
          },
          "server_id": {
            "type": "string",
            "description": "Id of the server: the verifier in the signed transcript."
          }
        }
      },
      "DbHealth": {
        "type": "object",
        "description": "State of the library database.",
        "required": [
          "status"
        ],
        "properties": {
          "schema_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Newest applied schema version; absent when the database fails."
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "description": "Whether the database answers."
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "description": "One device of the family.",
        "required": [
          "device_id",
          "name",
          "kind",
          "fingerprint",
          "added_ms"
        ],
        "properties": {
          "added_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When the device joined, Unix ms.",
            "minimum": 0
          },
          "device_id": {
            "type": "string",
            "description": "Device id."
          },
          "fingerprint": {
            "type": "string",
            "description": "Fingerprint of the device key."
          },
          "kind": {
            "type": "string",
            "description": "`phone`, `tablet`, `tv`, `desktop`, `server` or `other`; clients\ntreat unknown values as `other`."
          },
          "name": {
            "type": "string",
            "description": "Name shown to people."
          },
          "revoked_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "When the device was revoked, Unix ms; absent for active devices.",
            "minimum": 0
          }
        }
      },
      "DeviceLoginRequest": {
        "type": "object",
        "description": "Proof of a paired device key.",
        "required": [
          "device_id",
          "nonce",
          "challenge",
          "sig"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "The challenge from `/api/v1/auth/challenge`."
          },
          "device_id": {
            "type": "string",
            "description": "Device id in the family."
          },
          "nonce": {
            "type": "string",
            "description": "The device's own fresh nonce (64 hex characters)."
          },
          "sig": {
            "type": "string",
            "description": "`pa_pairing::auth::prove(identity, server_id, nonce, challenge)`:\nEd25519 signature, hex."
          }
        },
        "additionalProperties": false
      },
      "Devices": {
        "type": "object",
        "description": "The device family of the server.",
        "required": [
          "family",
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceInfo"
            },
            "description": "Devices of the family, revoked ones too."
          },
          "family": {
            "type": "string",
            "description": "Family id."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "What `/health` returns.",
        "required": [
          "service",
          "status",
          "version",
          "api",
          "db"
        ],
        "properties": {
          "api": {
            "$ref": "#/components/schemas/ApiVersion",
            "description": "Version of the HTTP API."
          },
          "db": {
            "$ref": "#/components/schemas/DbHealth",
            "description": "The library database."
          },
          "service": {
            "type": "string",
            "description": "Service name, `alpha-media`."
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "description": "`ok` when the server can serve requests."
          },
          "version": {
            "type": "string",
            "description": "Version of the server program."
          }
        }
      },
      "InviteResponse": {
        "type": "object",
        "description": "A new pairing invitation.",
        "required": [
          "code",
          "qr",
          "expires_ms",
          "fingerprint"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code to type on the new device."
          },
          "expires_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When the invitation expires, Unix ms.",
            "minimum": 0
          },
          "fingerprint": {
            "type": "string",
            "description": "Fingerprint of the server's device key in the family."
          },
          "qr": {
            "type": "string",
            "description": "QR payload (`projectalpha://pair?…`) with the same code."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Name and password.",
        "required": [
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "User name (any case)."
          },
          "password": {
            "type": "string",
            "description": "Password."
          }
        },
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "description": "The caller's session.",
        "required": [
          "session_id",
          "scope",
          "method"
        ],
        "properties": {
          "device_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The paired device it is bound to."
          },
          "method": {
            "$ref": "#/components/schemas/Method",
            "description": "How it was opened."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "description": "What the session may do."
          },
          "session_id": {
            "type": "string",
            "description": "Session id."
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserInfo",
                "description": "The signed-in user; absent for a device session."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Method": {
        "type": "string",
        "description": "How a session was opened.",
        "enum": [
          "password",
          "pin",
          "device"
        ]
      },
      "NewUser": {
        "type": "object",
        "description": "A new account.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name, unique without regard to case."
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Password (required for an administrator)."
          },
          "pin": {
            "type": [
              "string",
              "null"
            ],
            "description": "PIN of 4–8 digits."
          },
          "role": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Role",
                "description": "`member` (default) or `admin`."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "PinRequest": {
        "type": "object",
        "description": "Profile PIN.",
        "required": [
          "user_id",
          "pin"
        ],
        "properties": {
          "pin": {
            "type": "string",
            "description": "Its PIN."
          },
          "user_id": {
            "type": "string",
            "description": "The profile (user id) picked on the device."
          }
        },
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "description": "A refresh token.",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "The refresh token of the last pair."
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "type": "string",
        "description": "Role of an account.",
        "enum": [
          "admin",
          "member"
        ]
      },
      "Scope": {
        "type": "string",
        "description": "What a session may do.",
        "enum": [
          "admin",
          "member",
          "device"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "description": "First administrator.",
        "required": [
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the administrator."
          },
          "password": {
            "type": "string",
            "description": "Password, 8–256 characters."
          },
          "setup_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The code from `setup-code.txt` in the data directory; not needed on\nthe server itself."
          }
        },
        "additionalProperties": false
      },
      "SetupResponse": {
        "type": "object",
        "description": "The first administrator, signed in.",
        "required": [
          "user",
          "tokens"
        ],
        "properties": {
          "tokens": {
            "$ref": "#/components/schemas/Tokens",
            "description": "Its session."
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo",
            "description": "The new account."
          }
        }
      },
      "Status": {
        "type": "string",
        "description": "`ok` or `error`.",
        "enum": [
          "ok",
          "error"
        ]
      },
      "Tokens": {
        "type": "object",
        "description": "Access and refresh tokens of a session.",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "scope"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "PASETO `v4.public` access token for `Authorization: Bearer`."
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds the access token is valid.",
            "minimum": 0
          },
          "refresh_expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds the refresh token is valid.",
            "minimum": 0
          },
          "refresh_token": {
            "type": "string",
            "description": "Single-use refresh token: exchange it at `/api/v1/auth/refresh`\nfor a new pair. Presenting a used one again ends the session."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "description": "What the session may do."
          },
          "token_type": {
            "type": "string",
            "description": "Always `Bearer`."
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "description": "A user, without secrets.",
        "required": [
          "id",
          "name",
          "role",
          "has_password",
          "has_pin",
          "created_ms"
        ],
        "properties": {
          "created_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Created, Unix ms."
          },
          "has_password": {
            "type": "boolean",
            "description": "Signs in with a password."
          },
          "has_pin": {
            "type": "boolean",
            "description": "Has a profile PIN."
          },
          "id": {
            "type": "string",
            "description": "User id."
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Role."
          }
        }
      },
      "UserPatch": {
        "type": "object",
        "description": "Changes of an account; absent fields stay.",
        "properties": {
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "New password; an empty string removes it (not for administrators)."
          },
          "pin": {
            "type": [
              "string",
              "null"
            ],
            "description": "New PIN of 4–8 digits; an empty string removes it."
          }
        },
        "additionalProperties": false
      },
      "Users": {
        "type": "object",
        "description": "Accounts of the server.",
        "required": [
          "users"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserInfo"
            },
            "description": "By name."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "PASETO v4.public",
        "description": "Access token from /api/v1/auth/login, /pin, /device or /refresh; valid 15 min."
      }
    }
  },
  "tags": [
    {
      "name": "server",
      "description": "Liveness and versions"
    },
    {
      "name": "pairing",
      "description": "Device family: pairing and revocation (SYNC-005)"
    },
    {
      "name": "sync",
      "description": "Sync protocol over WebSocket (docs/api/sync-protocol.md)"
    },
    {
      "name": "auth",
      "description": "Accounts, sign-in and tokens (SRV-003)"
    }
  ]
}
