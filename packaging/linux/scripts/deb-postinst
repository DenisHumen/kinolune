#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
#
# kinolune .deb postinst (PKG-023): on the first install add the Kinolune APT
# repository so `apt upgrade` brings new versions (like Chrome and VS Code).
# Later upgrades only refresh files this package wrote (key rotation); a
# removed kinolune.sources stays removed. build-packages.sh fills in
# @BASE_URL@ and @CHANNEL@ (beta for a pre-release package, else stable).
set -e

MARK="# Kinolune repository (written by the kinolune package)"
KEYRING=/etc/apt/keyrings/kinolune.gpg
SOURCES=/etc/apt/sources.list.d/kinolune.sources

if [ "$1" = configure ]; then
    ours=false
    if [ -f "$SOURCES" ] && grep -qF "$MARK" "$SOURCES"; then ours=true; fi
    if { [ -z "$2" ] && [ ! -e "$SOURCES" ]; } || [ "$ours" = true ]; then
        suite=@CHANNEL@
        if [ "$ours" = true ]; then
            # Keep the channel the user picked (stable or beta).
            s=$(sed -n 's/^Suites:[[:space:]]*\([a-z]*\).*/\1/p' "$SOURCES" | head -n1)
            case "$s" in stable|beta) suite=$s ;; esac
        fi
        install -d -m 755 /etc/apt/keyrings
        install -m 644 /usr/share/kinolune/kinolune.gpg "$KEYRING"
        tmp="$SOURCES.dpkg-tmp"
        cat > "$tmp" <<SOURCES
$MARK
# Channel: Suites: stable or beta. Delete this file to stop updates from it.
Types: deb
URIs: @BASE_URL@/apt
Suites: $suite
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: $KEYRING
SOURCES
        chmod 644 "$tmp"
        mv -f "$tmp" "$SOURCES"
    fi
fi

exit 0
